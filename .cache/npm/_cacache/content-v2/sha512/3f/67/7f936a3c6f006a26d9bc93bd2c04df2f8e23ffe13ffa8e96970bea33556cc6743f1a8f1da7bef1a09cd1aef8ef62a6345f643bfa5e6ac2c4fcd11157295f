n":"5.6.0","_nodeVersion":"8.9.4","_npmUser":{"name":"strugee","email":"alex@strugee.net"},"dist":{"integrity":"sha512-7YKEapH+2Uikde8hySyfobXBqPKULDyHNl/lhKm7cKf/GJFdG/tU/WpLrOg2y9aUrQrWUilYqawFIiGJPS6gDA==","shasum":"0d8efa1abbb6d1dd926d255ce733b4f7c5ab2892","tarball":"https://registry.npmjs.org/cache-directory/-/cache-directory-2.0.0.tgz","fileCount":6,"unpackedSize":46213,"signatures":[{"keyid":"SHA256:jl3bwswu80PjjokCgh0o2w5c2U4LhQAE57gj9cz1kzA","sig":"MEQCIE/5v2N6SWrqWKL9kFwjSULU9Pj1iX6n65oviK8KjtjhAiBc8doxydzql50khQ/pBdVqoezASK5Z5To5qjpH6BAeBA=="}]},"maintainers":[{"name":"strugee","email":"alex@strugee.net"}],"directories":{},"_npmOperationalInternal":{"host":"s3://npm-registry-packages","tmp":"tmp/cache-directory_2.0.0_1519940244836_0.8239014722871825"},"_hasShrinkwrap":false}},"readme":"# `cache-directory`\n\nFind the proper cache directory based on operating system\n\n## Installation\n\n    npm install cache-directory\n\n## Usage\n\n`cache-directory` takes one argument, the app name.\n\n```js\nvar cacheDir = require('cache-directory');\n\nconsole.log(cacheDir('myApp'));\n```\n\n## Caveats\n\nWhen run on OS X, `cache-directory` assumes it isn't run in a sandboxed process environment. If it is, it will probably break. Additionally, the app name is used instead of the [conventional][1] bundle identifier (for simplicity and because many `cache-directory` consumers won't necessarily _have_ a bundle identifier).\n\nIf a suitable cache directory can't be found, `cache-directory` will return `null`. You need to handle this case. A reasonable course of action would be to use a temp directory, for which you can use the [`cache-or-tmp-directory`][2] module.\n\n## License\n\nLGPL 3.0+\n\n## Author\n\nAlex Jordan <alex@strugee.net>\n\n [1]: https://developer.apple.com/library/prerelease/content/documentation/FileManagement/Conceptual/FileSystemProgrammingGuide/MacOSXDirectories/MacOSXDirectories.html#//apple_ref/doc/uid/TP40010672-CH10-SW1\n [2]: https://npmjs.com/package/cache-or-tmp-directory\n","maintainers":[{"name":"strugee","email":"alex@strugee.net"}],"time":{"modified":"2022-06-13T05:23:12.424Z","created":"2016-07-22T08:29:33.124Z","1.0.0":"2016-07-22T08:29:33.124Z","1.1.0":"2016-07-24T06:35:23.382Z","2.0.0":"2018-03-01T21:37:24.940Z"},"homepage":"https://github.com/strugee/node-cache-directory#readme","keywords":["cache","xdg","directory"],"repository":{"type":"git","url":"git+https://github.com/strugee/node-cache-directory.git"},"author":{"name":"Alex Jordan","email":"alex@strugee.net"},"bugs":{"url":"https://github.com/strugee/node-cache-directory/issues"},"license":"LGPL-3.0+","readmeFilename":"README.md"}